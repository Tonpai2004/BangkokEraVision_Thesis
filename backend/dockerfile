# ใช้ Python 3.10-slim เพื่อความเบา
FROM python:3.10-slim

# แก้ไข Warning: Legacy key/value format โดยใช้เครื่องหมาย =
ENV PYTHONUNBUFFERED=True
ENV APP_HOME=/app
WORKDIR $APP_HOME

# ติดตั้ง dependencies ที่จำเป็นสำหรับระบบ
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements และติดตั้ง
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# โหลด Model ของ SentenceTransformer เก็บไว้ใน Image เลยเพื่อป้องกัน Cold Start ช้า
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('clip-ViT-B-32')"

# Copy โค้ดทั้งหมดเข้า Container
COPY . .

# รัน Gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "8", "--timeout", "300", "app:app"]